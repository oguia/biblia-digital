{
  "version": "0.4",
  "title": "Home Page Premium",
  "type": "page",
  "content": [
    {
      "id": "hero-section-premium",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "background_background": "classic",
        "background_color": "#1A2B3C",
        "padding": {
          "unit": "px",
          "top": "60",
          "right": "20",
          "bottom": "60",
          "left": "20"
        }
      },
      "elements": [
        {
          "id": "hero-column",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "hero-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "O Curador Urbano",
                "align": "center",
                "typography_typography": "custom",
                "typography_font_family": "Playfair Display",
                "typography_font_size": { "unit": "px", "size": 48 },
                "typography_font_weight": "700",
                "title_color": "#FFFFFF"
              }
            },
            {
              "id": "hero-subheading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "A seleção premium dos melhores produtos para você.",
                "align": "center",
                "typography_typography": "custom",
                "typography_font_family": "Open Sans",
                "typography_font_size": { "unit": "px", "size": 18 },
                "typography_font_weight": "400",
                "title_color": "#C19A6B",
                "margin": { "unit": "px", "top": "15", "bottom": "30" }
              }
            },
            {
              "id": "hero-search",
              "elType": "widget",
              "widgetType": "shortcode",
              "settings": {
                "shortcode": "[fibosearch]"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "category-section-premium",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "css_classes": "barra-categorias-guia",
        "padding": {
          "unit": "px",
          "top": "30",
          "bottom": "30"
        }
      },
      "elements": [
        {
          "id": "cat-col-1",
          "elType": "column",
          "settings": { "_column_size": 25 },
          "elements": [
            {
              "id": "iconbox-1",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "icon": { "value": "fas fa-laptop", "library": "solid" },
                "title_text": "Tecnologia",
                "view": "stacked",
                "shape": "circle",
                "position": "top",
                "title_size": "h4"
              }
            }
          ]
        },
        {
          "id": "cat-col-2",
          "elType": "column",
          "settings": { "_column_size": 25 },
          "elements": [
            {
              "id": "iconbox-2",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "icon": { "value": "fas fa-home", "library": "solid" },
                "title_text": "Casa",
                "view": "stacked",
                "shape": "circle",
                "position": "top"
              }
            }
          ]
        },
        {
          "id": "cat-col-3",
          "elType": "column",
          "settings": { "_column_size": 25 },
          "elements": [
            {
              "id": "iconbox-3",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "icon": { "value": "fas fa-car", "library": "solid" },
                "title_text": "Automotivo",
                "view": "stacked",
                "shape": "circle",
                "position": "top"
              }
            }
          ]
        },
        {
          "id": "cat-col-4",
          "elType": "column",
          "settings": { "_column_size": 25 },
          "elements": [
            {
              "id": "iconbox-4",
              "elType": "widget",
              "widgetType": "icon-box",
              "settings": {
                "icon": { "value": "fas fa-tshirt", "library": "solid" },
                "title_text": "Moda",
                "view": "stacked",
                "shape": "circle",
                "position": "top"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "products-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "padding": {
          "unit": "px",
          "top": "50",
          "bottom": "50"
        }
      },
      "elements": [
        {
          "id": "prod-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "prod-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Destaques da Curadoria",
                "align": "left",
                "margin": { "unit": "px", "bottom": "30" }
              }
            },
            {
              "id": "prod-shortcode",
              "elType": "widget",
              "widgetType": "shortcode",
              "settings": {
                "shortcode": "[products limit=\"8\" columns=\"4\" orderby=\"popularity\"]"
              }
            }
          ]
        }
      ]
    }
  ]
}
