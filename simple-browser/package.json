{
  "name": "simple-browser",
  "version": "1.0.0",
  "description": "A lightweight, secure browser for Windows",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "compile": "tsc",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none pnpm dev\" \"wait-on tcp:5173 && electron .\""
  },
  "keywords": [
    "electron",
    "browser",
    "secure",
    "lightweight"
  ],
  "author": "Jules",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "lucide-react": "^0.260.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.example.simplebrowser",
    "productName": "SimpleBrowser",
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
