<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block scraping bots and common vulnerabilities (HTTrack, Teleport, etc)
    RewriteCond %{HTTP_USER_AGENT} (bot|crawl|slurp|spider|Wget|HTTrack|WebZIP|Teleport|Offline\sExplorer|WebCopier|Zeus|python-requests|Scrapy) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule ^.* - [F,L]

    # Disable directory indexing
    Options -Indexes

    # Block sensitive files
    <FilesMatch "(^\.|db\.sqlite|.*\.sqlite|.*\.db|.*\.log|README\.md|\.env)">
        Require all denied
    </FilesMatch>

    # Allow CORS headers in preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS, PUT, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
